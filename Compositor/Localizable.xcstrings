    },
    "Keep the source moving with the brush between strokes; off starts every stroke at the source point": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Keep the source moving with the brush between strokes; off starts every stroke at the source point"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在各绘制笔触间保持取样源随画笔同步移动；关闭时每次落笔均从原始取样源重新开始"
          }
        }
      }
    },
    "Keep the subject clear of the haze; off, it's hazed by its own distance, so a figure far off is misted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Keep the subject clear of the haze; off, it's hazed by its own distance, so a figure far off is misted"
