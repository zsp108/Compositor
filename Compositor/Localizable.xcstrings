    "Linear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Linear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线性"
          }
        }
      }
    },
    "Linear blurs along the line; Radial keeps the start sharp and blurs outwards": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Linear blurs along the line; Radial keeps the start sharp and blurs outwards"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“线性”沿线条方向模糊；“径向”保持起始点清晰并向外扩散模糊"
          }
        }
      }
    },
    "Linear histogram with automatic vertical scaling. Tall spikes may extend beyond the graph; all tones from 0 to 255 remain included.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Linear histogram with automatic vertical scaling. Tall spikes may extend beyond the graph; all tones from 0 to 255 remain included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "具备自动垂直缩放的线性直方图。较高的峰值可能会超出图表；从 0 到 255 的全部色调均已涵盖。"
          }
        }
      }
    },
    "Linear runs along the line; Radial spreads out from the start point": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Linear runs along the line; Radial spreads out from the start point"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“线性”沿线条延伸；“径向”自起点向外扩散"
          }
        }
      }
    },
    "Linear splits along one direction; Radial splits outwards from a center, sharp there": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Linear splits along one direction; Radial splits outwards from a center, sharp there"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“线性”沿单向分色；“径向”由中心向外周分色（中心保持清晰）"
          }
        }
