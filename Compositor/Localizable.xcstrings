        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持主体不受薄雾笼罩；关闭时根据主体自身的景深距离笼罩雾气，使远景人物呈现朦胧雾感"
          }
        }
      }
    },
